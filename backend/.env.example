# Copy to .env and fill in. Never commit .env.

# --- Application ------------------------------------------------------------
ENVIRONMENT=development          # development | test | staging | production
DEBUG=true
APP_NAME=PENUMBRA.AI

# --- Database ---------------------------------------------------------------
# SQLite by default so the stack runs with no external services.
# Production refuses to start on SQLite -- see Settings.assert_production_ready.
DATABASE_URL=sqlite:///./penumbra.db
# DATABASE_URL=postgresql://penumbra:CHANGE_ME@localhost:5432/penumbra
DATABASE_ECHO=false

# --- Authentication ---------------------------------------------------------
# Generate with: python -c "from app.config import Settings; print(Settings.generate_secret())"
JWT_SECRET=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Cryptography -----------------------------------------------------------
# Public CKKS contexts are 35 MB at N=8192 with rotation keys, 180 MB at
# N=16384, so they live here rather than in a database column.
KEYSTORE_DIR=./keystore
MAX_PUBLIC_CONTEXT_BYTES=268435456
MAX_CIPHERTEXT_BYTES=67108864
# BB84 is a protocol demonstration, not a source of key material.
ENABLE_BB84_SIMULATION=false
SESSION_TTL_SECONDS=3600

# --- Portfolio limits -------------------------------------------------------
MAX_ASSETS_PER_PORTFOLIO=200
MAX_UPLOAD_BYTES=5242880

# --- Agents (Phase 2) -------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=4096
AGENT_TIMEOUT_SECONDS=300

# --- Optimisation (Phase 4) -------------------------------------------------
QAOA_LAYERS=3
QAOA_MAX_ITERATIONS=100
QAOA_SHOTS=2048
# Simulation cost is exponential in qubit count; 20 is comfortable, 28 is the
# practical ceiling on a laptop.
MAX_QUBITS=20

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
